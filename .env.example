# Copy to .env and adjust. Variables marked (later) are read from the milestone named.

# Host port for docker compose
MAGMA_PORT=8080

# Public URL of the app (used for SSO redirects)
BASE_URL=http://localhost:8080

# Database: SQLite file in the /data volume (default) or PostgreSQL
DATABASE_URL=sqlite:////data/magma.db
# DATABASE_URL=postgresql+psycopg://magma:secret@postgres:5432/magma

# Secret for session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# First admin account, created on first start when no users exist.
# Without ADMIN_PASSWORD a random password is generated and printed once in the container log.
ADMIN_USER=admin
# ADMIN_PASSWORD=

# Local login and session settings
# LOCAL_LOGIN_ENABLED=true
# SESSION_HOURS=12

# SSO via OpenID Connect (Entra ID, Keycloak, Okta, ADFS, Authentik ...).
# Register the redirect URI <BASE_URL>/api/auth/oidc/callback at your IdP.
# SSO is on when OIDC_ISSUER and OIDC_CLIENT_ID are set.
# OIDC_ISSUER=https://login.example.com/realms/soc
# OIDC_CLIENT_ID=magma
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Claim with the groups/roles; dotted paths work, e.g. realm_access.roles
# OIDC_ROLE_CLAIM=groups
# OIDC_ROLE_MAP=SOC-Admins=admin,SOC-Analysts=analyst,Audit=auditor
# Role for users without a matching group (empty = no access)
# OIDC_DEFAULT_ROLE=
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_BUTTON_LABEL=Sign in with SSO
#
# Local test with the bundled Keycloak (docker compose --profile keycloak up -d):
# OIDC_ISSUER=http://keycloak:8080/realms/magma
# OIDC_CLIENT_ID=magma
# OIDC_CLIENT_SECRET=magma-dev-secret
# OIDC_ROLE_MAP=SOC-Admins=admin,SOC-Analysts=analyst,Audit=auditor

# Load generated demo data on first start (random but reproducible per seed).
# Can also be loaded later from Users > Demo data, or with: python -m app.demo --seed 42
# DEMO_DATA=false
# DEMO_SEED=42

# Default re-verification interval for operational rules (days); rules can override it
# DEFAULT_VERIFICATION_DAYS=180
